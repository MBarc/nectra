#!/usr/bin/env python3
"""Sweep the code-only Laya stakes weight on the tuning corpus."""

import argparse
import json
from pathlib import Path
import re
import subprocess


def run(cmd: list[str], root: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, cwd=root, text=True, capture_output=True, check=False)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", required=True)
    parser.add_argument("--corpus", default="eval/laya/long-spec-tuning.json")
    parser.add_argument("--step", type=float, default=0.025)
    parser.add_argument("--max", type=float, default=0.6)
    args = parser.parse_args()

    root = Path(__file__).resolve().parents[2]
    corpus = (root / args.corpus).resolve()
    expected = (root / "eval/laya/long-spec-tuning.json").resolve()
    if corpus != expected:
        raise SystemExit(f"refusing non-tuning corpus: {corpus}")

    built = run(["cargo", "build", "--release"], root)
    if built.returncode:
        raise SystemExit(built.stderr)
    # A sibling copy of the config, so its relative registry path still resolves.
    config = Path(args.config).resolve()
    original = re.sub(r"(?m)^stakes_weight\s*=.*\n", "", config.read_text())
    swept = config.with_name(config.stem + ".stakes-sweep.toml")

    rows = []
    try:
        count = round(args.max / args.step)
        for index in range(count + 1):
            weight = round(index * args.step, 6)
            line = f"stakes_weight = {weight}\n"
            if re.search(r"(?m)^\[routing\]\s*$", original):
                text = re.sub(r"(?m)^\[routing\]\s*\n", "[routing]\n" + line, original, count=1)
            else:
                text = original + "\n[routing]\n" + line
            swept.write_text(text)
            evaluated = run(
                [
                    str(root / "target/release/nectra"),
                    "--config",
                    str(swept),
                    "eval",
                    str(corpus),
                ],
                root,
            )
            try:
                report = json.loads(evaluated.stdout)
            except json.JSONDecodeError as error:
                raise SystemExit(evaluated.stderr or str(error)) from error
            tier = report["tier"]
            row = {
                "weight": weight,
                "tier_accuracy": tier["accuracy"],
                "classifier": tier["demanding_tier"],
                "router": tier["demanding_model"],
                "task_accuracy": report["accuracy"],
                "keyword_fallbacks": report["keyword_fallbacks"],
            }
            rows.append(row)
            print(json.dumps(row), flush=True)
    finally:
        swept.unlink(missing_ok=True)

    baseline_fp = rows[0]["router"]["fp"]
    eligible = [row for row in rows if row["router"]["fp"] <= baseline_fp]
    chosen = max(
        eligible,
        key=lambda row: (
            row["router"]["tp"],
            row["classifier"]["tp"],
            -row["weight"],
        ),
    )
    print(json.dumps({"baseline_router_fp": baseline_fp, "chosen": chosen}, indent=2))


if __name__ == "__main__":
    main()
