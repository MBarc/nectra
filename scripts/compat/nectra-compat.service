# User unit: the provider CLIs use your own logins. Install with docs/compat.md.
[Unit]
Description=Nectra: adapt to provider CLI changes
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/nectra
Environment=PATH=%h/.local/bin:%h/.cargo/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/nectra/scripts/compat/adapt.py --live --nectra %h/nectra/target/release/nectra
TimeoutStartSec=1h
# Issues exit 1; the report is in ~/.local/state/nectra/compat either way.
SuccessExitStatus=1
